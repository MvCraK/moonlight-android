<?xml version="1.0" encoding="utf-8"?>
<!-- EXTENSION DEVELOPMENT [EXT-SS-NETWORK] [ADDED] -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#26FF6B7A" />
            <stroke android:width="2dp" android:color="#FF6B7A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#40FF6B7A" />
            <stroke android:width="1dp" android:color="#99FF6B7A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#14FF6B7A" />
            <stroke android:width="1dp" android:color="#66FF6B7A" />
        </shape>
    </item>
</selector>
