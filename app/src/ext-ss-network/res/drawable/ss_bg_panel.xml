<?xml version="1.0" encoding="utf-8"?>
<!-- EXTENSION DEVELOPMENT [EXT-SS-NETWORK] [ADDED] -->
<!-- Nearly opaque home-panel surface so the content stays readable over any background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="315"
                android:endColor="#FA0B0D1E"
                android:startColor="#FA191732" />
        </shape>
    </item>
</layer-list>
