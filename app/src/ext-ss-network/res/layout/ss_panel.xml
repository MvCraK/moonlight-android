<?xml version="1.0" encoding="utf-8"?>
<!-- EXTENSION DEVELOPMENT [EXT-SS-NETWORK] [ADDED] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ss_bg_panel"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: state tile, title + state line, close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/ssPanelTile"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_home_icon_tile">

            <ImageView
                android:id="@+id/ssPanelIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="11dp" />

            <View
                android:id="@+id/ssPanelDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ss_panel_title"
                android:textColor="@color/home_primary_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ssPanelState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_secondary_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ssPanelClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_home_circle_button"
            android:contentDescription="@string/ss_action_close"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ss_ic_close" />
    </LinearLayout>

    <!-- System VPN / FlClash coexistence banner -->
    <TextView
        android:id="@+id/ssPanelVpnBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/ss_bg_banner_info"
        android:lineSpacingExtra="2dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.limelight.extensions.ss.SsMaxHeightScrollView
        android:id="@+id/ssPanelScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fadeScrollbars="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/ssPanelEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ss_bg_section"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ss_empty_title"
                    android:textColor="@color/home_primary_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/ss_empty_body"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ssPanelContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Home route mode selector -->
                <TextView
                    style="@style/SsPanelSectionTitle"
                    android:text="@string/ss_section_home_mode" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ssModeDirect"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/ss_bg_segment_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/ssModeDirectTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ss_mode_direct"
                            android:textColor="@color/home_primary_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ssModeDirectSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ss_mode_direct_sub"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ssModeRelay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/ss_bg_segment_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/ssModeRelayTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ss_mode_relay"
                            android:textColor="@color/home_primary_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ssModeRelaySub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ss_mode_relay_sub"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Active nodes -->
                <TextView
                    style="@style/SsPanelSectionTitle"
                    android:layout_marginTop="12dp"
                    android:text="@string/ss_section_nodes" />

                <LinearLayout
                    android:id="@+id/ssPanelNodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ss_bg_section"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="4dp" />

                <!-- Routes summary -->
                <TextView
                    style="@style/SsPanelSectionTitle"
                    android:layout_marginTop="12dp"
                    android:text="@string/ss_section_routes" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ss_bg_section"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="10.0.0.0/24"
                            android:textColor="@color/home_primary_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_home_meta_pill"
                            android:text="@string/ss_route_home"
                            android:textColor="@color/home_accent_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ssRouteHomeDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/ss_route_home_detail"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="11.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="10.1.1.0/24"
                            android:textColor="@color/home_primary_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_home_meta_pill"
                            android:text="@string/ss_route_company"
                            android:textColor="@color/home_accent_bright"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/ss_route_company_detail"
                        android:textColor="@color/home_secondary_text"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- Compact telemetry strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/ss_bg_section"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ss_stat_received"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/ssPanelReceived"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:textColor="@color/home_primary_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/ss_bg_section"
                        android:orientation="vertical"
                        android:padding="11dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ss_stat_updated"
                            android:textColor="@color/home_secondary_text"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/ssPanelUpdated"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/home_primary_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/ss_direct_note"
                    android:textColor="@color/home_secondary_text"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </com.limelight.extensions.ss.SsMaxHeightScrollView>

    <!-- Status / error notice -->
    <TextView
        android:id="@+id/ssPanelMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Secondary actions -->
    <LinearLayout
        android:id="@+id/ssPanelSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ssPanelImport"
            style="@style/SsPanelSecondaryAction"
            android:text="@string/ss_action_import" />

        <TextView
            android:id="@+id/ssPanelRefresh"
            style="@style/SsPanelSecondaryAction"
            android:layout_marginStart="8dp"
            android:text="@string/ss_action_refresh" />

        <TextView
            android:id="@+id/ssPanelProbe"
            style="@style/SsPanelSecondaryAction"
            android:layout_marginStart="8dp"
            android:text="@string/ss_action_probe" />
    </LinearLayout>

    <!-- Primary toggle button -->
    <TextView
        android:id="@+id/ssPanelPrimary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/ss_bg_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="14.5sp"
        android:textStyle="bold" />
</LinearLayout>
