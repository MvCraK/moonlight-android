<?xml version="1.0" encoding="utf-8"?>
<!-- EXTENSION DEVELOPMENT [EXT-SS-NETWORK] [ADDED] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/ssNodeDot"
        android:layout_width="8dp"
        android:layout_height="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ssNodeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/home_primary_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ssNodeHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/home_secondary_text"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ssNodeLatency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_home_meta_pill"
        android:textColor="@color/home_secondary_text"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
